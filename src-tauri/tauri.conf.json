{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist"
  },
  "package": {
    "productName": "ZabbLeaf",
    "version": "3.4.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "scope": [
          { "name": "pdflatex", "cmd": "pdflatex", "args": true },
          { "name": "xelatex", "cmd": "xelatex", "args": true },
          { "name": "lualatex", "cmd": "lualatex", "args": true }
        ]
      },
      "fs": {
        "all": true,
        "scope": ["$APP", "$APP/**", "$DESKTOP/**", "$DOCUMENT/**"]
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://git.overleaf.com/*", "https://github.com/*"]
      },
      "path": {
        "all": true
      },
      "window": {
        "all": false,
        "close": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "dmg", "appimage"],
      "identifier": "com.zabbleaf.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 720,
        "resizable": true,
        "title": "ZabbLeaf — Offline Overleaf Desktop IDE",
        "width": 1280
      }
    ]
  }
}
